# Copy to .env and fill in real values. Never commit the real .env.
# Every variable here must match CONTRACTS.md §1 exactly — update that
# file first if a name or default needs to change.

# --- Postgres ---
POSTGRES_DB=globetrotter
POSTGRES_USER=globetrotter
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Backend (derived DATABASE_URL is also set directly in docker-compose.yml) ---
API_PORT=8000
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# --- Google Maps (Maps JS API + Directions API + Places API — CONTRACTS §7.2/§7.4) ---
# Two SEPARATE keys. Never reuse the server key as the browser key.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# --- Groq (Smart Trip Assistant — CONTRACTS §7.1) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
